<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phát triển bởi"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitStart"
        android:src="@drawable/screenshot_2026_05_23_150929"
        app:tint="#0984E3" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỂ LOẠI PHIM"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phổ biến" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang chiếu" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sắp chiếu" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KHÁM PHÁ"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phim lẻ" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phim bộ" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV Shows" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỂ LOẠI TRUYỀN HÌNH"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chương trình Phổ biến" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phát sóng Hôm nay" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đánh giá cao" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MẠNG LƯỚI CỦA CHÚNG TÔI"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIMO Network" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIMO Studio" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FIMO Community" android:textColor="#CCCCCC" android:textSize="13sp" android:layout_marginBottom="10dp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#222222" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GHI CÔNG TMDB"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sản phẩm này sử dụng API của TMDB nhưng không được TMDB xác nhận hoặc chứng nhận. Chúng tôi sử dụng TMDB (Cơ sở dữ liệu phim) làm nguồn tham khảo cho các thông tin liên quan đến phim, chương trình truyền hình và giải trí. Tất cả dữ liệu, bao gồm hình ảnh, mô tả và đánh giá, do TMDB cung cấp và là tài sản của chủ sở hữu tương ứng."
        android:textColor="#666666"
        android:textSize="10sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUYÊN BỐ MIỄN TRỪ TRÁCH NHIỆM CHUNG"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chúng tôi không phải là nhà cung cấp phim, chương trình truyền hình, tin tức hoặc dịch vụ phát trực tuyến. Chúng tôi không lưu trữ, tải lên hoặc phân phối bất kỳ nội dung truyền thông nào. Tất cả nội dung, bao gồm thông tin, hình ảnh và đoạn giới thiệu (trailer), đều được lấy từ các nền tảng của bên thứ ba công khai và chỉ được cung cấp cho mục đích thông tin và giải trí. Tất cả nhãn hiệu, biểu trưng và phương tiện truyền thông đều thuộc về chủ sở hữu tương ứng của chúng."
        android:textColor="#666666"
        android:textSize="10sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="20dp" />

</LinearLayout>